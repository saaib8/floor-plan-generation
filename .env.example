# ─── OpenAI / Gemini ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# ─── FastAPI server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── PostgreSQL (Mesaky DB) ───────────────────────────────────────────────────
# Option A – full DSN (recommended)
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Option B – individual vars (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mesaky
# DB_USER=postgres
# DB_PASSWORD=secret

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
# Explicit credentials (skip if running on EC2/ECS with an IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Bucket that holds the 2D icon SVGs (core_product.two_d_icon keys)
TWO_D_ICON_BUCKET=zory-temporary-uploads-backup

# Comma-separated S3 key prefix(es) to scan for icons
TWO_D_ICON_PREFIX=2D_icons

# How long (seconds) to cache the S3 key listing in memory
TWO_D_ICON_S3_CACHE_SECONDS=300

# ─── Validation (optional) ────────────────────────────────────────────────────
# VALIDATION_ENABLED=true
# VALIDATION_MAX_ATTEMPTS=3
# VALIDATION_CANDIDATES_PER_ATTEMPT=1

# ─── Composition / dollhouse view backend ─────────────────────────────────────
# The composite (dollhouse) views are the only images users see. Backends:
#   oneshot   – DEFAULT. One call per view: the floor render + all four wall elevations are sent
#               together (IMAGE 1=floor, 2=N, 3=S, 4=E, 5=W) with an explicit Image→compass map
#               in the prompt; the model removes the near wall and renders the cutaway in a single
#               pass. Fewest model calls = lowest latency. Two opposite views (remove S / remove N).
#   gemini    – Gemini image model builds an open-box shell from the floor, then adds each
#               wall's products one at a time (generative geometry; can mirror/duplicate walls).
#   openai    – same sequential pipeline on gpt-image-2.
#   geometric – GUIDE-ANCHORED (DEFAULT). The room box, camera, the exact two walls, floor
#               diamond, and opening rectangles are COMPUTED (geometry.py) and rendered as a flat
#               structure guide. The model furnishes the floor onto that locked guide, then paints
#               each wall's decor onto its (guide-locked) plane one elevation at a time. The
#               computed guide makes an extra wall, a mirrored wall, or two same-angle views
#               structurally impossible, while every pixel is still photorealistically rendered
#               (no stickered/flat walls, no warp seams). Best balance of correctness + realism.
# COMPOSITION_BACKEND=oneshot          # oneshot (default) | geometric | gemini | openai
# GEMINI_API_KEY=...                   # required when backend=gemini
# GEMINI_IMAGE_MODEL=gemini-3-pro-image  # or gemini-3.1-flash-image (faster/cheaper)
# COMPOSITION_ASPECT_RATIO=4:3         # 1:1, 4:3, 3:2, 16:9, 5:4, ...
# COMPOSITION_IMAGE_SIZE=2K            # 1K | 2K | 4K (4K is highest fidelity, slower)

# ─── Composition / dollhouse QA (optional) ────────────────────────────────────
# Each composite gets a GPT-4o vision QA gate that compares the result against the floor
# render + each wall elevation + authoritative openings and scores it. On failure it
# retries: attempt 1 = best-of-N (parallel); later attempts = targeted refine edits that
# converge on the flagged issues. Set ENABLED=false to skip QA entirely (fastest).
# COMPOSITION_VALIDATION_ENABLED=true
# COMPOSITION_MAX_ATTEMPTS=2            # retries: each attempt is a fresh batch of candidates
# COMPOSITION_CANDIDATES_PER_ATTEMPT=2  # best-of-N per attempt, generated in PARALLEL; keep best
# COMPOSITION_SCORE_THRESHOLD=0.80
