# ─── OpenAI / Gemini ─────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# ─── FastAPI server ───────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── PostgreSQL (Mesaky DB) ───────────────────────────────────────────────────
# Option A – full DSN (recommended)
DATABASE_URL=postgresql://username:password@host:5432/dbname

# Option B – individual vars (used if DATABASE_URL is not set)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mesaky
# DB_USER=postgres
# DB_PASSWORD=secret

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
# Explicit credentials (skip if running on EC2/ECS with an IAM role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1

# Bucket that holds the 2D icon SVGs (core_product.two_d_icon keys)
TWO_D_ICON_BUCKET=zory-temporary-uploads-backup

# Comma-separated S3 key prefix(es) to scan for icons
TWO_D_ICON_PREFIX=2D_icons

# How long (seconds) to cache the S3 key listing in memory
TWO_D_ICON_S3_CACHE_SECONDS=300

# ─── Validation (optional) ────────────────────────────────────────────────────
# VALIDATION_ENABLED=true
# VALIDATION_MAX_ATTEMPTS=3
# VALIDATION_CANDIDATES_PER_ATTEMPT=1
