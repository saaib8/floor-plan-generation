OPENAI_API_KEY=sk-...
GEMINI_API_KEY=

# FastAPI server
HOST=0.0.0.0
PORT=8000

# DB/S3 settings are loaded from the parent Mesaky backend .env.
# Override only if you want a different icon bucket for Product.two_d_icon keys.
TWO_D_ICON_BUCKET=zory-temporary-uploads-backup
TWO_D_ICON_PREFIX=2D_icons
TWO_D_ICON_S3_CACHE_SECONDS=300
